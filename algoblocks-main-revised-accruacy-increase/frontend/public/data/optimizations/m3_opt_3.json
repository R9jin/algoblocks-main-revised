  "pythonCode": "def search_optimized(arr, target, low, high):\n    if high == None:\n        high = len(arr) - 1\n\n    if low > high:\n        return -1\n    mid = (low + high) // 2\n\n    if arr[mid] == target:\n        return mid\n    else:\n        if arr[mid] > target:\n            return search_optimized(arr, target, low, mid - 1)\n        else:\n            return search_optimized(arr, target, mid + 1, high)"
}