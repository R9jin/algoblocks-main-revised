  "pythonCode": "def subset_sum_opt(arr, target, n):\n    if n == None:\n        n = len(arr)\n\n    if target == 0:\n        return True\n\n    if n == 0:\n        return False\n\n    if arr[n - 1] > target:\n        return subset_sum_opt(arr, target, n - 1)\n\n    return subset_sum_opt(arr, target, n - 1) or subset_sum_opt(arr, target - arr[n - 1], n - 1)"
}