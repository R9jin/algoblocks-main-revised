  "pythonCode": "def is_safe_naive(board, row, col, n):\n    for i in range(row):\n        if board[i] == col or board[i] - i == col - row or board[i] + i == col + row:\n            return False\n\n    return True\n\n\ndef solve_n_queens_naive(board, row, n):\n    if row == n:\n        return 1\n    count = 0\n\n    for col in range(n):\n        if is_safe_naive(board, row, col, n):\n            board[row] = col\n            count += (solve_n_queens_naive(board, row + 1, n))\n\n    return count\n\n\ndef n_queens_opt(n):\n    board = [-1] * n\n\n    return solve_n_queens_naive(board, 0, n)"
}