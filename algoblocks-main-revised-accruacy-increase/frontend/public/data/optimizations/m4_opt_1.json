  "pythonCode": "def greedy_sum_opt(arr, k):\n    total = 0\n    temp_arr = list(arr)\n\n    for _2 in range(k):\n        if not temp_arr:\n            break\n        max_val = temp_arr[0]\n        max_idx = 0\n\n        for i in range(1, len(temp_arr)):\n            if temp_arr[i] > max_val:\n                max_val = temp_arr[i]\n                max_idx = i\n        total += max_val\n        temp_arr.pop(max_idx)\n\n    return total"
}