  "pythonCode": "def schedule_opt(activities, idx, last_end):\n    if idx >= len(activities):\n        return 0\n    exclude = schedule_opt(activities, idx + 1, last_end)\n    include = 0\n\n    if activities[idx][0] >= last_end:\n        include = 1 + schedule_opt(activities, idx + 1, activities[idx][1])\n\n    return max(exclude, include)"
}