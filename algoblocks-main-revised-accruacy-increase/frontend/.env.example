# frontend/.env.example
#
# Copy to `.env.local` for local development, or set in your hosting
# provider (Vercel project settings) for production. Never commit a real
# `.env*` file -- already excluded via .gitignore.
#
# IMPORTANT: Vite bundles anything prefixed VITE_ directly into the public
# JS served to every visitor's browser. Only put values here that are safe
# for the whole world to see (a base API URL, an OAuth *client* ID -- never
# an API secret, a database URL, or a JWT signing key). All real secrets
# live only in api/.env on the server, never here.

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Client ID (safe to expose -- it identifies the app, not
# a secret; the backend independently verifies the token against the same
# ID via GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
