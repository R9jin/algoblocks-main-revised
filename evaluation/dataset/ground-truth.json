  {
    "id": "logarithmic_binary_08",
    "name": "Binary Search (Recursive)",
    "code": "def binary_search_rec(arr, left, right, target):\n    if left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] > target:\n            return binary_search_rec(arr, left, mid - 1, target)\n        else:\n            return binary_search_rec(arr, mid + 1, right, target)\n    return -1",
