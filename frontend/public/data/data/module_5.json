{
  "lesson_1": [
    {
      "id": "m5_l1_a1",
      "title": "Array Caching",
      "task": "Scenario: Mathematical sequence tabulation. Task: Write `cache_seq(n)` building a cache array where index `i` is the sum of `i-1` and `i-2`, starting with 0 and 1. Return the full array up to n. Handle negative n by returning [].",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "cache_seq(4)", "expected": "[0, 1, 1, 2, 3]", "isHidden": false },
        { "call": "cache_seq(6)", "expected": "[0, 1, 1, 2, 3, 5, 8]", "isHidden": false },
        { "call": "cache_seq(0)", "expected": "[0]", "isHidden": false },
        { "call": "cache_seq(1)", "expected": "[0, 1]", "isHidden": true },
        { "call": "cache_seq(-3)", "expected": "[]", "isHidden": true }
      ]
    }
  ],
  "lesson_2": [
    {
      "id": "m5_l2_a4",
      "title": "Space-Optimized Fibonacci",
      "task": "Scenario: Dropping array memory to O(1). Task: Write `fib_opt(n)` using only two variables to track the previous two values. Return the nth number.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "fib_opt(5)", "expected": "5", "isHidden": false },
        { "call": "fib_opt(8)", "expected": "21", "isHidden": false },
        { "call": "fib_opt(10)", "expected": "55", "isHidden": false },
        { "call": "fib_opt(0)", "expected": "0", "isHidden": true },
        { "call": "fib_opt(1)", "expected": "1", "isHidden": true }
      ]
    }
  ],
  "lesson_3": [
    {
      "id": "m5_l3_a3",
      "title": "Knapsack Matrix",
      "task": "Scenario: The Adventurer's Knapsack calculation. Task: Write `knapsack(weights, values, capacity)` returning the maximum value achievable. Ensure safety against 0 capacity.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "knapsack([1, 2, 3], [10, 15, 40], 5)", "expected": "55", "isHidden": false },
        { "call": "knapsack([2, 3, 4, 5], [3, 4, 5, 6], 5)", "expected": "7", "isHidden": false },
        { "call": "knapsack([10, 20], [100, 200], 5)", "expected": "0", "isHidden": false },
        { "call": "knapsack([1, 1], [10, 20], 0)", "expected": "0", "isHidden": true },
        { "call": "knapsack([], [], 10)", "expected": "0", "isHidden": true }
      ]
    }
  ],
  "lesson_4": [
    {
      "id": "m5_l4_a4",
      "title": "Full LCS Table",
      "task": "Scenario: Sequence matching algorithm. Task: Write `lcs_length(s1, s2)` returning the integer length of the Longest Common Subsequence.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "lcs_length('ABCBDAB', 'BDCAB')", "expected": "4", "isHidden": false },
        { "call": "lcs_length('AGGTAB', 'GXTXAYB')", "expected": "4", "isHidden": false },
        { "call": "lcs_length('AAAA', 'AA')", "expected": "2", "isHidden": false },
        { "call": "lcs_length('', 'ABC')", "expected": "0", "isHidden": true },
        { "call": "lcs_length('XYZ', 'ABC')", "expected": "0", "isHidden": true }
      ]
    }
  ]
}