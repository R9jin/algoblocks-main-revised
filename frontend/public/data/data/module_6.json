{
  "lesson_1": [
    {
      "id": "m6_l1_a4",
      "title": "Recursive Exploration",
      "task": "Scenario: Branching out possibilities. Task: Write `explore(n)` generating all binary strings of length n as a list of strings.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "explore(2)", "expected": "['00', '01', '10', '11']", "isHidden": false },
        { "call": "explore(1)", "expected": "['0', '1']", "isHidden": false },
        { "call": "explore(3)", "expected": "['000', '001', '010', '011', '100', '101', '110', '111']", "isHidden": false },
        { "call": "explore(0)", "expected": "['']", "isHidden": true },
        { "call": "explore(-1)", "expected": "[]", "isHidden": true }
      ]
    }
  ],
  "lesson_2": [
    {
      "id": "m6_l2_a3",
      "title": "Subsets Generation",
      "task": "Scenario: The Chef's Ingredients. Task: Write `subsets(arr)` using backtracking returning a list of all subsets including the empty set.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "subsets(['A', 'B'])", "expected": "[[], ['A'], ['A', 'B'], ['B']]", "isHidden": false },
        { "call": "subsets(['Salt'])", "expected": "[[], ['Salt']]", "isHidden": false },
        { "call": "subsets([])", "expected": "[[]]", "isHidden": false },
        { "call": "subsets([1, 2])", "expected": "[[], [1], [1, 2], [2]]", "isHidden": true },
        { "call": "subsets([None])", "expected": "[[], [None]]", "isHidden": true }
      ]
    }
  ],
  "lesson_3": [
    {
      "id": "m6_l3_a5",
      "title": "Full N-Queens Solver",
      "task": "Scenario: The Grandmaster's Challenge. Task: Write `n_queens(n)` returning the total number of distinct valid solutions. Fallback: return 0 if n < 1.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "n_queens(4)", "expected": "2", "isHidden": false },
        { "call": "n_queens(5)", "expected": "10", "isHidden": false },
        { "call": "n_queens(1)", "expected": "1", "isHidden": false },
        { "call": "n_queens(2)", "expected": "0", "isHidden": true },
        { "call": "n_queens(-5)", "expected": "0", "isHidden": true }
      ]
    }
  ],
  "lesson_4": [
    {
      "id": "m6_l4_a5",
      "title": "Subset Sum Solver",
      "task": "Scenario: Exact value target backtracking. Task: Write `subset_sum(arr, target)` returning a single sub-array that adds up to target, or [] if none.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "subset_sum([3, 34, 4, 12, 5, 2], 9)", "expected": "[4, 5]", "isHidden": false },
        { "call": "subset_sum([1, 2, 3], 10)", "expected": "[]", "isHidden": false },
        { "call": "subset_sum([1, 2, 3], 3)", "expected": "[3]", "isHidden": false },
        { "call": "subset_sum([10, 20, 30], 0)", "expected": "[]", "isHidden": true },
        { "call": "subset_sum([], 5)", "expected": "[]", "isHidden": true }
      ]
    }
  ]
}