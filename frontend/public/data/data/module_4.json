{
  "lesson_1": [
    {
      "id": "m4_l1_a3",
      "title": "Greedy Sum",
      "task": "Scenario: Game Show Winner maximizing profit. Task: Write `greedy_sum(arr)` that picks the 3 largest bags of money and returns their sum. If less than 3 bags exist, sum all.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "greedy_sum([10, 50, 20, 100, 5])", "expected": "170", "isHidden": false },
        { "call": "greedy_sum([15, 25])", "expected": "40", "isHidden": false },
        { "call": "greedy_sum([5, 5, 5, 5])", "expected": "15", "isHidden": false },
        { "call": "greedy_sum([])", "expected": "0", "isHidden": true },
        { "call": "greedy_sum([-10, -50, -20])", "expected": "-80", "isHidden": true }
      ]
    }
  ],
  "lesson_2": [
    {
      "id": "m4_l2_a1",
      "title": "The Cashier",
      "task": "Scenario: Providing Philippine exact change. Task: Write `change_ph(amount)` returning a list representing the counts of [20, 10, 5, 1] peso coins used greedily. Return 'Invalid' for negative amounts.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "change_ph(47)", "expected": "[2, 0, 1, 2]", "isHidden": false },
        { "call": "change_ph(99)", "expected": "[4, 1, 1, 4]", "isHidden": false },
        { "call": "change_ph(20)", "expected": "[1, 0, 0, 0]", "isHidden": false },
        { "call": "change_ph(0)", "expected": "[0, 0, 0, 0]", "isHidden": true },
        { "call": "change_ph(-5)", "expected": "'Invalid'", "isHidden": true }
      ]
    }
  ],
  "lesson_3": [
    {
      "id": "m4_l3_a2",
      "title": "Event Scheduler",
      "task": "Scenario: Maximizing non-overlapping events. Task: Write `schedule(starts, ends)` returning the maximum count of events that can be scheduled using greedy activity selection.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "schedule([1, 3, 0, 5, 8, 5], [2, 4, 6, 7, 9, 9])", "expected": "4", "isHidden": false },
        { "call": "schedule([10, 12, 20], [20, 25, 30])", "expected": "2", "isHidden": false },
        { "call": "schedule([1, 2, 3], [2, 3, 4])", "expected": "3", "isHidden": false },
        { "call": "schedule([], [])", "expected": "0", "isHidden": true },
        { "call": "schedule([1, 1, 1], [5, 5, 5])", "expected": "1", "isHidden": true }
      ]
    }
  ]
}