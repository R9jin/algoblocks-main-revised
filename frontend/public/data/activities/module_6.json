        { "call": "combine([1],2)", "expected": "[]", "isHidden": true }
      ]
    },
    {
      "id": "m6_l2_a5",
      "title": "Keypad Letters",
      "task": "Generate letter combinations for digits '23'.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "keypad('23')", "expected": "['ad','ae','af','bd','be','bf','cd','ce','cf']", "isHidden": false },
