{
  "lesson_1": [
    {
      "id": "m6_l1_a1",
      "title": "The Choose Step",
      "task": "Build a path by adding elements one by one into an array and return the final path.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "choose([1,2,3])", "expected": "[1, 2, 3]", "isHidden": false },
        { "call": "choose([5])", "expected": "[5]", "isHidden": false },
        { "call": "choose([])", "expected": "[]", "isHidden": false },
        { "call": "choose([None])", "expected": "[None]", "isHidden": true },
        { "call": "choose([1, None, 3])", "expected": "[1, None, 3]", "isHidden": true }
      ]
    },
    {
      "id": "m6_l1_a2",
      "title": "The Unchoose Step",
      "task": "Remove the last element from a path to simulate backtracking.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "unchoose([1,2,3])", "expected": "[1, 2]", "isHidden": false },
        { "call": "unchoose([5])", "expected": "[]", "isHidden": false },
        { "call": "unchoose([])", "expected": "[]", "isHidden": false },
        { "call": "unchoose([1, None])", "expected": "[1]", "isHidden": true },
        { "call": "unchoose([None])", "expected": "[]", "isHidden": true }
      ]
    },
    {
      "id": "m6_l1_a3",
      "title": "State Validation",
      "task": "Return true only if a path meets a condition (no negative numbers allowed).",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "validate([1,2,3])", "expected": "true", "isHidden": false },
        { "call": "validate([0,5])", "expected": "true", "isHidden": false },
        { "call": "validate([-1,2])", "expected": "false", "isHidden": false },
        { "call": "validate([])", "expected": "true", "isHidden": true },
        { "call": "validate([1,-5,3])", "expected": "false", "isHidden": true }
      ]
    },
    {
      "id": "m6_l1_a4",
      "title": "Recursive Exploration",
      "task": "Generate all binary strings of length n.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "explore(2)", "expected": "['00', '01', '10', '11']", "isHidden": false },
        { "call": "explore(1)", "expected": "['0', '1']", "isHidden": false },
        { "call": "explore(3)", "expected": "['000', '001', '010', '011', '100', '101', '110', '111']", "isHidden": false },
        { "call": "explore(0)", "expected": "['']", "isHidden": true },
        { "call": "explore(-1)", "expected": "[]", "isHidden": true }
      ]
    },
    {
      "id": "m6_l1_a5",
      "title": "Base Case Print",
      "task": "Return current path when target depth is reached.",
      "randomizeTestCases": true,
      "testCasesPool": [
        { "call": "base_case([1,2], 2)", "expected": "[1, 2]", "isHidden": false },
        { "call": "base_case([5], 1)", "expected": "[5]", "isHidden": false },
        { "call": "base_case([], 0)", "expected": "[]", "isHidden": false },
        { "call": "base_case([1], 2)", "expected": "[]", "isHidden": true },
        { "call": "base_case([1,2,3], 2)", "expected": "[1, 2]", "isHidden": true }
      ]
    }
  ],

  "lesson_2": [
