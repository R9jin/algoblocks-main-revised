  "lesson_1": [
    {
      "id": "m3_l1_a1",
      "title": "Halving an Array",
      "task": "Given an array, split it into two parts at the midpoint (floor of length/2). Return a 2D array in the format [leftHalf, rightHalf], preserving original order.",
      "testCasesPool": [
        { "call": "halve_array([1,2,3,4])", "expected": "[[1,2],[3,4]]", "isHidden": false },
        { "call": "halve_array([10,20,30])", "expected": "[[10],[20,30]]", "isHidden": false },
        { "call": "halve_array([5])", "expected": "[[5],[]]", "isHidden": false },
        { "call": "halve_array([])", "expected": "[[],[]]", "isHidden": true },
        { "call": "halve_array([1,2,3,4,5])", "expected": "[[1,2],[3,4,5]]", "isHidden": true }
      ]
    },
    {
      "id": "m3_l1_a2",
      "title": "Find Midpoint",
      "task": "Given two integers l and r, compute and return the midpoint index using floor((l + r) / 2).",
      "testCasesPool": [
        { "call": "midpoint(0,9)", "expected": "4", "isHidden": false },
        { "call": "midpoint(1,5)", "expected": "3", "isHidden": false },
        { "call": "midpoint(2,2)", "expected": "2", "isHidden": false },
        { "call": "midpoint(0,0)", "expected": "0", "isHidden": true },
        { "call": "midpoint(3,10)", "expected": "6", "isHidden": true }
      ]
    },
    {
      "id": "m3_l1_a3",
      "title": "Recursive Countdown",
      "task": "Given an integer n, recursively construct and return a list counting down from n to 1. If n is less than or equal to 0, return ['Abort'].",
      "testCasesPool": [
        { "call": "countdown(3)", "expected": "[3,2,1]", "isHidden": false },
        { "call": "countdown(5)", "expected": "[5,4,3,2,1]", "isHidden": false },
        { "call": "countdown(1)", "expected": "[1]", "isHidden": false },
        { "call": "countdown(0)", "expected": "['Abort']", "isHidden": true },
        { "call": "countdown(-5)", "expected": "['Abort']", "isHidden": true }
      ]
    },
    {
      "id": "m3_l1_a4",
      "title": "Recursive Factorial",
      "task": "Given a non-negative integer n, return its factorial (n!) using recursion. The base case is n = 0 or n = 1, both returning 1.",
      "testCasesPool": [
        { "call": "factorial(5)", "expected": "120", "isHidden": false },
        { "call": "factorial(4)", "expected": "24", "isHidden": false },
        { "call": "factorial(3)", "expected": "6", "isHidden": false },
        { "call": "factorial(0)", "expected": "1", "isHidden": true },
        { "call": "factorial(1)", "expected": "1", "isHidden": true }
      ]
    },
    {
      "id": "m3_l1_a5",
      "title": "Recursive Sum",
      "task": "Given a non-negative integer n, return the sum of all integers from 1 to n using recursion. If n is less than or equal to 0, return 0.",
      "testCasesPool": [
        { "call": "sum_recursive(5)", "expected": "15", "isHidden": false },
        { "call": "sum_recursive(10)", "expected": "55", "isHidden": false },
        { "call": "sum_recursive(3)", "expected": "6", "isHidden": false },
        { "call": "sum_recursive(0)", "expected": "0", "isHidden": true },
        { "call": "sum_recursive(-2)", "expected": "0", "isHidden": true }
      ]
    }
