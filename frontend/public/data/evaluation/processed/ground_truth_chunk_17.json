    "id": "algo_n2_166",
    "name": "Python3 program to replace c1 with c2",
    "code": "# Python3 program to replace c1 with c2\n# and c2 with c1\ndef replace(s, c1, c2):\n    l = len(s)\n     \n    # loop to traverse in the string\n    for i in range(l):\n         \n        # check for c1 and replace\n        if (s[i] == c1):\n            s = s[0:i] + c2 + s[i + 1:]\n         \n        # check for c2 and replace\n        elif (s[i] == c2):\n            s = s[0:i] + c1 + s[i + 1:]\n    return s\n \n# Driver Code\nif __name__ == '__main__':\n    s = \"grrksfoegrrks\"\n    c1 = 'e'\n    c2 = 'r'\n    print(replace(s, c1, c2))\n \n# This code is contributed\n# by PrinciRaj1992",
