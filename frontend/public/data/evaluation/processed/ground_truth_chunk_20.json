    "name": "Python3 program to reverse order of vowels",
    "code": "# Python3 program to reverse order of vowels\n \n# utility function to check for vowel\ndef isVowel(c):\n    if (c == 'a' or c == 'A' or c == 'e' or\n        c == 'E' or c == 'i' or c == 'I' or\n        c == 'o' or c == 'O' or c == 'u' or c == 'U'):\n        return True\n    return False\n \n# Function to reverse order of vowels\ndef reverserVowel(string):\n    j = 0\n    vowel = [0] * len(string)\n    string = list(string)\n \n    # Storing the vowels separately\n    for i in range(len(string)):\n        if isVowel(string[i]):\n            vowel[j] = string[i]\n            j += 1\n \n    # Placing the vowels in the reverse\n    # order in the string\n    for i in range(len(string)):\n        if isVowel(string[i]):\n            j -= 1\n            string[i] = vowel[j]\n \n    return ''.join(string)\n \n# Driver Code\nif __name__ == \"__main__\":\n    string = \"hello world\"\n    print(reverserVowel(string))\n \n# This code is contributed by\n# sanjeev2552",
