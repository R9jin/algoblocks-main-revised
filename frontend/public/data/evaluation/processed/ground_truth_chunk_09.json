    "code": "# Python 3program to check if a\n# string is of the form a^nb^n.\n  \n# Returns true str is of the\n# form a^nb^n.\n  \n  \ndef isAnBn(str):\n  \n    n = len(str)\n  \n    # After this loop 'i' has\n    # count of a's\n    for i in range(n):\n        if (str[i] != 'a'):\n            break\n  \n    # Since counts of a's and b's should\n    # be equal, a should appear exactly\n    # n/2 times\n    if (i * 2 != n):\n        return False\n  \n    # Rest of the characters must\n    # be all 'b'\n    for j in range(i, n):\n        if (str[j] != 'b'):\n            return False\n  \n    return True\n  \n  \n# Driver code\nif __name__ == \"__main__\":\n    str = \"abab\"\n    print(\"Yes\") if isAnBn(str) else print(\"No\")\n  \n# This code is contributed\n# by ChitraNayal",
