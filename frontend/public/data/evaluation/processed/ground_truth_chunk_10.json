    "code": "def countRotations(arr, n):\n    # Check is array is rotated\n    if (arr[0] > arr[n - 1]):\n \n        # Traverse the array\n        for i in range(0, n):\n \n            # Index where element is greater\n            # than the next element\n            if (arr[i] > arr[i + 1]):\n                return i + 1\n \n    # Array is not rotated\n    return 0\n \n# Driver code\narr = [15, 18, 2, 3, 6, 12]\nn = len(arr)\nprint(countRotations(arr, n))\n \n# This code is contributed by karandeep1234",
