  {
    "id": "algo_ve_290",
    "name": "Topological Sort using Kahn's Algorithm",
    "code": "# Python3 program for Topological\n# Sorting of a DAG using Kahn's\n# Algorithm (BFS based)\nfrom collections import deque\n\ndef topological_sort(graph, vertices):\n    in_degree = [0] * vertices\n\n    # Compute in-degree of each vertex\n    for node in graph:\n        for neighbour in graph[node]:\n            in_degree[neighbour] += 1\n\n    # Enqueue all vertices with in-degree 0\n    queue = deque([v for v in range(vertices) if in_degree[v] == 0])\n    order = []\n\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n\n        # Reduce in-degree of neighbours\n        for neighbour in graph.get(node, []):\n            in_degree[neighbour] -= 1\n            if in_degree[neighbour] == 0:\n                queue.append(neighbour)\n\n    return order\n\n\n# Driver code\nif __name__ == '__main__':\n    graph = {0: [1, 2], 1: [3], 2: [3], 3: []}\n    print(topological_sort(graph, 4))\n",
