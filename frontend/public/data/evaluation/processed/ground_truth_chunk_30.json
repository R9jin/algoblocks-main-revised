    "code": "# Python3 program to count the distinct\n# prime factors of a number using\n# trial division up to sqrt(n)\nimport math\n\ndef count_prime_factors(n):\n    count = 0\n\n    # Remove factors of 2 first\n    if n % 2 == 0:\n        count += 1\n        while n % 2 == 0:\n            n //= 2\n\n    # Only odd factors up to sqrt(n)\n    # remain to be checked\n    i = 3\n    while i <= int(math.sqrt(n)):\n        if n % i == 0:\n            count += 1\n            while n % i == 0:\n                n //= i\n        i += 2\n\n    # Whatever is left is itself prime\n    if n > 2:\n        count += 1\n\n    return count\n\n\n# Driver code\nif __name__ == '__main__':\n    n = 360\n    print(count_prime_factors(n))\n",
