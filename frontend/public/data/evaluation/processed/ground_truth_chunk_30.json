    "id": "algo_ve_291",
    "name": "Count Connected Components in an Undirected Graph",
    "code": "# Python3 program to count the number\n# of connected components in an\n# undirected graph using DFS\n\ndef dfs_visit(graph, node, visited):\n    visited.add(node)\n\n    # Visit every unvisited neighbour\n    for neighbour in graph.get(node, []):\n        if neighbour not in visited:\n            dfs_visit(graph, neighbour, visited)\n\n\ndef count_components(graph, vertices):\n    visited = set()\n    components = 0\n\n    # Start a fresh DFS from every\n    # unvisited vertex\n    for node in range(vertices):\n        if node not in visited:\n            dfs_visit(graph, node, visited)\n            components += 1\n\n    return components\n\n\n# Driver code\nif __name__ == '__main__':\n    graph = {0: [1], 1: [0], 2: [3], 3: [2], 4: []}\n    print(count_components(graph, 5))\n",
