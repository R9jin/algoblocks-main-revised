    "id": "algo_ve_287",
    "name": "Breadth First Traversal of a graph",
    "code": "# Python3 program for Breadth First\n# Traversal of a graph represented\n# using adjacency list (dict of lists)\nfrom collections import deque\n\ndef bfs(graph, start):\n    # Set to keep track of visited nodes\n    visited = set()\n    visited.add(start)\n\n    # Queue for BFS\n    queue = deque([start])\n    order = []\n\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n\n        # Explore all neighbours of the\n        # current node\n        for neighbour in graph[node]:\n            if neighbour not in visited:\n                visited.add(neighbour)\n                queue.append(neighbour)\n\n    return order\n\n\n# Driver code\nif __name__ == '__main__':\n    graph = {\n        0: [1, 2],\n        1: [0, 3],\n        2: [0, 3],\n        3: [1, 2]\n    }\n    print(bfs(graph, 0))\n",
