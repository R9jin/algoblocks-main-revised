    "id": "algo_ve_289",
    "name": "Detect Cycle in a Directed Graph using DFS",
    "code": "# Python3 program to detect cycle in a\n# directed graph using DFS and a\n# recursion stack\n\ndef is_cyclic_util(graph, node, visited, rec_stack):\n    visited.add(node)\n    rec_stack.add(node)\n\n    # Visit all neighbours of the node\n    for neighbour in graph.get(node, []):\n        if neighbour not in visited:\n            if is_cyclic_util(graph, neighbour, visited, rec_stack):\n                return True\n        elif neighbour in rec_stack:\n            return True\n\n    rec_stack.remove(node)\n    return False\n\n\ndef is_cyclic(graph, vertices):\n    visited = set()\n    rec_stack = set()\n\n    # Try starting DFS from every vertex\n    for node in range(vertices):\n        if node not in visited:\n            if is_cyclic_util(graph, node, visited, rec_stack):\n                return True\n\n    return False\n\n\n# Driver code\nif __name__ == '__main__':\n    graph = {0: [1], 1: [2], 2: [0]}\n    print(is_cyclic(graph, 3))\n",
