    "id": "algo_ve_288",
    "name": "Iterative Depth First Traversal of a graph",
    "code": "# Python3 program for iterative Depth\n# First Traversal of a graph represented\n# using adjacency list (dict of lists)\n\ndef dfs(graph, start):\n    # Stack for DFS and set of visited nodes\n    visited = set()\n    stack = [start]\n    order = []\n\n    while stack:\n        node = stack.pop()\n\n        if node not in visited:\n            visited.add(node)\n            order.append(node)\n\n            # Push all unvisited neighbours\n            # onto the stack\n            for neighbour in graph[node]:\n                if neighbour not in visited:\n                    stack.append(neighbour)\n\n    return order\n\n\n# Driver code\nif __name__ == '__main__':\n    graph = {\n        0: [1, 2],\n        1: [0, 3],\n        2: [0, 3],\n        3: [1, 2]\n    }\n    print(dfs(graph, 0))\n",
