    "id": "algo_ve_292",
    "name": "Check whether a Graph is Bipartite using BFS",
    "code": "# Python3 program to check whether an\n# undirected graph is Bipartite using\n# BFS based 2-colouring\nfrom collections import deque\n\ndef is_bipartite(graph, vertices):\n    color = [-1] * vertices\n\n    for start in range(vertices):\n        if color[start] != -1:\n            continue\n\n        color[start] = 0\n        queue = deque([start])\n\n        while queue:\n            node = queue.popleft()\n\n            # Try to colour every neighbour\n            # the opposite colour\n            for neighbour in graph.get(node, []):\n                if color[neighbour] == -1:\n                    color[neighbour] = 1 - color[node]\n                    queue.append(neighbour)\n                elif color[neighbour] == color[node]:\n                    return False\n\n    return True\n\n\n# Driver code\nif __name__ == '__main__':\n    graph = {0: [1, 3], 1: [0, 2], 2: [1, 3], 3: [0, 2]}\n    print(is_bipartite(graph, 4))\n",
