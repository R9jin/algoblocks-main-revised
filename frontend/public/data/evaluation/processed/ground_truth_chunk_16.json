    "name": "Python 3 program for getting minimum character",
    "code": "# Python 3 program for getting minimum character\n# to be added at front to make string palindrome\n \n# function for checking string is\n# palindrome or not\ndef ispalindrome(s):\n \n    l = len(s)\n     \n    i = 0\n    j = l - 1\n    while i <= j:\n     \n        if(s[i] != s[j]):\n            return False\n        i += 1\n        j -= 1\n     \n    return True\n \n# Driver code\nif __name__ == \"__main__\":\n     \n    s = \"BABABAA\"\n    cnt = 0\n    flag = 0\n     \n    while(len(s) > 0):\n     \n        # if string becomes palindrome then break\n        if(ispalindrome(s)):\n            flag = 1\n            break\n         \n        else:\n            cnt += 1\n         \n            # erase the last element of the string\n            s = s[:-1]\n     \n    # print the number of insertion at front\n    if(flag):\n        print(cnt)\n \n# This code is contributed by ita_c",
