  "pythonCode": "def knapsack_optimized(weights, values, capacity, n):\n    if n == None:\n        n = len(weights)\n\n    if n == 0 or capacity == 0:\n        return 0\n\n    if weights[n - 1] > capacity:\n        return knapsack_optimized(weights, values, capacity, n - 1)\n    else:\n        exclude = knapsack_optimized(weights, values, capacity, n - 1)\n        include = values[n - 1] + knapsack_optimized(weights, values, capacity - weights[n - 1], n - 1)\n\n        return max(exclude, include)"
}