  "pythonCode": "def find_peak(arr):\n    if not arr:\n        return -1\n\n    if len(arr) == 1:\n        return 0\n\n    for i in range(len(arr)):\n        left_smaller = i == 0 or arr[i] > arr[i - 1]\n        right_smaller = i == len(arr) - 1 or arr[i] > arr[i + 1]\n\n        if left_smaller and right_smaller:\n            return i\n\n    return 0"
}