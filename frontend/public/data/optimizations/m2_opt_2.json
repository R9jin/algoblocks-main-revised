  "pythonCode": "def find_majority_sorted(arr):\n    for i in range(len(arr)):\n        count = 0\n\n        for j in range(len(arr)):\n            if arr[i] == arr[j]:\n                count += 1\n\n        if count > len(arr) // 2:\n            return arr[i]\n\n    return 0"
}