# api/.env.example
#
# Copy to api/.env for local development, or set these in your hosting
# provider (Vercel project settings) for production. Never commit a real
# api/.env file -- it's already excluded via .gitignore.

# Neon/PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWT access tokens. Generate a long random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
JWT_SECRET_KEY=change-me-to-a-long-random-value

# Google OAuth 2.0 Client ID (same value as frontend's VITE_GOOGLE_CLIENT_ID).
# Used to verify Google Sign-In tokens server-side.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Base URL of the deployed frontend, used as a fallback when building
# email links (verification / password reset) if the request's Origin
# header is missing or untrusted. See services/mail_service.py.
FRONTEND_URL=http://localhost:5173

# --- Gmail SMTP (verification + password reset emails) --------------------
# Google documents smtp.gmail.com with port 587 for STARTTLS (465 is the
# SSL alternative). SMTP_PASSWORD must be a Gmail App Password, not the
# account's normal login password -- generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=AlgoBlocks
