    "name": "Check if a Number is a Perfect Square in O(sqrt n)",
    "code": "# Python3 program to check whether a\n# number is a perfect square by trial\n# multiplication up to sqrt(n)\n\ndef is_perfect_square(n):\n    if n < 0:\n        return False\n\n    i = 1\n\n    # Increase i until i * i reaches\n    # or passes n\n    while i * i < n:\n        i += 1\n\n    return i * i == n\n\n\n# Driver code\nif __name__ == '__main__':\n    n = 144\n    print(is_perfect_square(n))\n",
