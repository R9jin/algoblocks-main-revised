    "id": "algo_n2_036",
    "name": "Python3 program to find equilibrium",
    "code": "# Python3 program to find equilibrium\n# index of an array\n \n# function to find the equilibrium index\n \n \ndef equilibrium(arr):\n    leftsum = 0\n    rightsum = 0\n    n = len(arr)\n \n    # Check for indexes one by one\n    # until an equilibrium index is found\n    for i in range(n):\n        leftsum = 0\n        rightsum = 0\n \n        # get left sum\n        for j in range(i):\n            leftsum += arr[j]\n \n        # get right sum\n        for j in range(i + 1, n):\n            rightsum += arr[j]\n \n        # if leftsum and rightsum are same,\n        # then we are done\n        if leftsum == rightsum:\n            return i\n \n    # return -1 if no equilibrium index is found\n    return -1\n \n \n# Driver code\nif __name__ == \"__main__\":\n    arr = [-7, 1, 5, 2, -4, 3, 0]\n \n    # Function call\n    print(equilibrium(arr))\n \n# This code is contributed by Abhishek Sharama",
